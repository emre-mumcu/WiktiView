@model DictionaryIndex
@{
    ViewData["Title"] = "Hazırlanıyor";
    var percent = (int)Math.Round(Model.Progress * 100);
}
@section Head {
    @if (Model.State != IndexState.Failed)
    {
        <meta http-equiv="refresh" content="3" />
    }
}

@if (Model.State == IndexState.Failed)
{
    <div class="alert alert-danger">
        <h1 class="h5">Sözlük yüklenemedi</h1>
        <p class="mb-0">@Model.Error</p>
    </div>
}
else
{
    <h1 class="h4">Sözlük dizini hazırlanıyor…</h1>
    <p class="text-body-secondary">
        Veri dosyası ilk çalıştırmada bir kez taranır ve dizin önbelleğe yazılır. Sayfa otomatik olarak yenilenecek.
    </p>
    <progress class="w-100" value="@percent" max="100">@percent%</progress>
    <div class="small text-body-secondary">@percent%</div>
}
