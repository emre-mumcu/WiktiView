@inject DictionaryIndex DictionaryIndex
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · WiktiView</title>
    @await RenderSectionAsync("Head", required: false)
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand bg-body-tertiary border-bottom mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">WiktiView</a>
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" asp-controller="Words" asp-action="Index">Kelimeler</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Words" asp-action="Random">Rastgele</a></li>
            </ul>
        </div>
    </nav>

    <main class="container flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 small text-body-secondary">
        <div class="container">
            @if (DictionaryIndex.IsReady)
            {
                var metadata = DictionaryIndex.Snapshot.Metadata;
                <div>Kaynak: @metadata.Source</div>
                <div>Lisans: @metadata.License</div>
            }
            else
            {
                <div>Kaynak: Wiktionary (de.wiktionary.org) · Lisans: CC BY-SA 4.0</div>
            }
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
